<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- h.ii.zi: the self-update download runs as a foreground dataSync service (required from targetSdk 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- h.iii.zi: lets a later update of the store install without Android's confirmation screen (API 31+, only when
         Android allows it); the first update on a device and Android 8 to 11 still ask. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 47i: lets this store ask Android 14+ to make it the update owner of the apps it installs (first install only;
         best effort, an install never fails on it). -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Z-P26: lets this store drive Dhizuku's shared Device-Owner process for silent installs. Declared
         by Dhizuku's own client AAR; repeated here so the merge is explicit. Dhizuku is never bundled —
         when it is absent, every Dhizuku call degrades to a clean "not available". -->
    <uses-permission android:name="com.rosan.dhizuku.permission.API" />
    <!-- Z-P26: the store shows its own progress/completion notification while an install runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".AppstoreApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Appstore"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false">

        <!-- S-P3: the managed-configuration keys a device policy controller may set. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Appstore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link from D-Store's "Open" button. Chrome only launches an app from an
                 intent: link when an activity declares BROWSABLE; the launcher filter above
                 does not, so Open fell back to re-downloading an installed app. No data on
                 purpose: the link is intent:#Intent;package=<id>;S.browser_fallback_url=...;end -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <!-- D-Store's Uninstall link: vyxelapps://uninstall/<package> opens Android's uninstall confirmation. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vyxelapps" android:host="uninstall" />
            </intent-filter>
        </activity>

        <!-- Required for installing APKs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- e.i: FCM token refresh + message delivery. Inert unless FCM_* build config is set. -->
        <service
            android:name=".AppstoreMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- h.iii.zi: result of the store's own PackageInstaller session (SelfInstaller). Not exported: only the system
             delivers to it, through the PendingIntent the session was committed with. -->
        <receiver
            android:name=".SelfUpdateReceiver"
            android:exported="false" />

        <!-- h.iii.zo: reopens the store after its own update replaced it (acts only for an update this store committed). -->
        <receiver
            android:name=".SelfUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- h.ii.zi: WorkManager's own foreground service, given the dataSync type the permission above is for. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Shizuku provider for privileged APK installation -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <meta-data
                android:name="rikka.shizuku.ShizukuProvider.MANAGER_APPLICATION_ID"
                android:value="moe.shizuku.privileged.api" />
        </provider>

        <activity
            android:name="rikka.shizuku.ShizukuRequestPermissionActivity"
            android:exported="true" />

        <!-- Home-screen widget: App of the Day + pending updates -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <!-- PackageInstaller session callbacks for the Expressive UI installer. -->
        <receiver
            android:name=".expressive.install.InstallResultReceiver"
            android:exported="false" />

        <!-- Z-P26: runs a Shizuku/Dhizuku/root `pm` call to completion in the foreground, with a
             progress notification, so leaving the app cannot kill an in-flight silent install. -->
        <service
            android:name=".silent.SilentInstallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Installing or removing an app through a user-enabled silent-install backend (Shizuku, Dhizuku, root)." />
        </service>
    </application>

</manifest>