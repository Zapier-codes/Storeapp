<?xml version="1.0" encoding="utf-8"?>
<!--
  S-P3: the keys a device policy controller (Android Enterprise / Headwind MDM / any DPC) may set
  through managed configuration. Declared here so a DPC's console shows the same names the client
  reads in `ManagedConfigRules`. Every key is optional; one the organisation omits leaves the
  person's own choice in place.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Comma/space separated SourceId names (e.g. "Zealot,FDroid,GitHub"). Blank = person chooses;
         "none" = no sources. Unknown names are ignored. -->
    <restriction
        android:key="enabled_sources"
        android:title="@string/restriction_enabled_sources_title"
        android:description="@string/restriction_enabled_sources_description"
        android:restrictionType="string"
        android:defaultValue="" />

    <!-- true/false. Unset leaves the person's own choice. -->
    <restriction
        android:key="show_desktop_sources"
        android:title="@string/restriction_show_desktop_sources_title"
        android:description="@string/restriction_show_desktop_sources_description"
        android:restrictionType="bool" />

    <!-- Comma/space separated package names the store must always hide. The person cannot restore
         these in-app. -->
    <restriction
        android:key="hidden_packages"
        android:title="@string/restriction_hidden_packages_title"
        android:description="@string/restriction_hidden_packages_description"
        android:restrictionType="string"
        android:defaultValue="" />

</restrictions>
